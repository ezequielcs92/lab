# Liga Argentina de Béisbol (LAB) - Variables de entorno
# Copiar a .env.local y completar con los valores de tu proyecto Supabase

# Supabase - obtener desde: supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-solo-servidor

# Secreto aleatorio de al menos 32 bytes para anonimizar visitantes de votacion MVP
MVP_VOTE_HASH_SECRET=generar-un-secreto-aleatorio-largo

# En Vercel: se auto-configura con VERCEL_URL, pero también se puede setear manualmente
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# Cloudflare R2
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET_NAME=tu-bucket
R2_PUBLIC_URL=https://media.example.com

# Google Sheets: compartir la planilla con el email de la cuenta de servicio
GOOGLE_SERVICE_ACCOUNT_EMAIL=lab-sync@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=id-de-la-planilla
